# Environment variables for Workforce
# Copy to .env.local and fill in. Never commit .env.local.

# Node
NODE_ENV=development
PORT=4000

# Database (Phase 3+)
DATABASE_URL=

# Redis (Phase 2+)
REDIS_URL=

# LLM providers (Phase 1+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Embeddings (Phase 3+)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
