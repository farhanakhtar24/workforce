# Environment variables for @workforce/api (Phase 2 chat + Phase 3 memory + Phase 4 multi-agent)
# Copy to .env.local and fill in. Never commit .env.local.
# No dotenv autoload: compose the process environment yourself (e.g. node --env-file).

# Ollama Cloud API key. Required only to START the server (src/server.ts);
# tests inject a mock model and need no key. Never logged, never returned.
OLLAMA_API_KEY=

# Ollama Cloud OpenAI-compatible base URL. The provider appends /chat/completions,
# so the default already includes /v1. Trailing slashes are stripped on load.
OLLAMA_BASE_URL=https://ollama.com/v1

# Chat + compaction model id (same provider as Phase 1).
OLLAMA_MODEL=glm-5.3-flash

# Redis is required (messages, active stream IDs, idempotency keys, checkpoints,
# and the BullMQ memory queue). Without it the API returns explicit 503s instead
# of pretending guarantees hold.
REDIS_URL=redis://127.0.0.1:6379

# Postgres (with pgvector) memory store URL. REQUIRED to start the server
# (src/server.ts); tests and buildApp callers inject stores instead. The value
# is never logged. Defaults to the local dev stack (docker-compose `postgres`:
# db/user/password all `workforce`) — set this only to override, e.g. for a
# different port or a real deployment (Phase 6 deployment must set an explicit
# secret URL, never this local default). Run the memory migration yourself
# (`npm run db:migrate`); the API never migrates.
DATABASE_URL=postgresql://workforce:workforce@127.0.0.1:55432/workforce

# Local model cache for the local embedding provider (Transformers.js,
# Xenova/all-MiniLM-L6-v2). Relative values resolve against the app cwd;
# the first embedding embeds/downloads the model into this directory.
EMBEDDING_CACHE_DIR=.cache/workforce-models

# Port the Express API listens on.
PORT=3001

# Allowed CORS origin for the Next.js web app; also the only origin that may
# send the Idempotency-Key header.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Phase 4 (multi-agent) — all optional; defaults below are the shipped ones.
# ---------------------------------------------------------------------------

# Loopback base URL the capability tools and the delegation runner call (the
# OWN REST API; ADR-002). Defaults to http://127.0.0.1:<PORT>.
# INTERNAL_API_BASE_URL=http://127.0.0.1:3001

# HMAC secret for the server-signed internal delegation context
# (X-Workforce-Delegation-Context). When absent, a per-boot randomBytes(32)
# secret is generated and a safe warning is logged (contexts do not survive
# restarts, which is honest for local dev). Values are never logged.
# DELEGATION_CONTEXT_SECRET=

# Whole delegation budget (child chat + SSE consumption) in ms. Bounds 1000..600000.
# DELEGATION_TIMEOUT_MS=120000

# statement_timeout for query_data reads. Bounds 100..300000.
# QUERY_STATEMENT_TIMEOUT_MS=2000

# Row cap for query_data, enforced as LIMIT (cap + 1) — cap+1 rows is a fixed
# 400, never silent truncation. Bounds 1..10000.
# QUERY_ROW_CAP=200
