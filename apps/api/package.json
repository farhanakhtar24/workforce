{
  "name": "@workforce/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "dev:scheduler": "tsx --watch src/scheduler-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:scheduler": "node dist/scheduler-worker.js",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test-live/*.test.ts",
    "test:embedding": "tsx --test test-embedding/local-embedding.test.ts",
    "demo:memory": "tsx scripts/seed-memory-demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:integration": "tsc --noEmit -p tsconfig.live.json",
    "typecheck:embedding": "tsc --noEmit -p tsconfig.embedding.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.94",
    "@huggingface/transformers": "^4.3.2",
    "@workforce/core": "0.1.0",
    "@workforce/queue": "0.1.0",
    "ai": "^6.0.333",
    "bullmq": "^6.7.8",
    "express": "^4.22.3",
    "ioredis": "^5.8.1",
    "pg": "8.23.1",
    "redis": "^6.3.1",
    "resumable-stream": "^2.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.19",
    "@types/express": "^4.17.25",
    "@types/pg": "8.23.1",
    "tsx": "^4.23.15"
  }
}
