// Prisma schema for the Workforce Phase 3 memory domain.
//
// The generated client is emitted to `packages/core/generated/prisma`
// (gitignored; reproducible via `prisma generate`). Only the Postgres memory
// adapter under `@workforce/core/memory/postgres` is allowed to import the
// generated client, so the CLI and the pure domain module never load Prisma.
//
// Identifiers use Prisma defaults (quoted PascalCase tables, camelCase
// columns) so this handwritten SQL and any future `prisma migrate diff`
// output stay in sync — no @map renames are used on purpose.
//
// `embedding` uses the pgvector `vector(384)` type via `Unsupported`. It is
// read and written exclusively through raw SQL in the Postgres adapter and is
// never returned to callers (embedding values never leave the store).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemoryKind {
  learning
  correction
  changelog
  observation
  decision
  preference
}

enum EmbeddingStatus {
  pending
  ready
  failed
}

enum MemoryRelationType {
  supports
  supersedes
  contradicts
}

model MemoryBlock {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope           String
  path            String
  kind            MemoryKind
  content         String
  confidence      Float                @db.DoublePrecision
  embeddingStatus EmbeddingStatus      @default(pending)
  embedding       Unsupported("vector(384)")?
  embeddingModel  String?
  accessCount     Int                  @default(0)
  // Intentionally NOT @unique: ONE summary/correction block supersedes many
  // sources, so several rows share the same supersededById value. One-successor
  // integrity per source row is enforced by the adapter's guarded UPDATE
  // (see packages/core/src/memory/postgres), not by a DB constraint.
  supersededById  String?              @db.Uuid
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now())
  embeddedAt      DateTime?
  lastAccessedAt  DateTime?

  supersededBy MemoryBlock?   @relation("MemoryBlockSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersedes   MemoryBlock[]  @relation("MemoryBlockSupersededBy")

  sourceRelations MemoryRelation[] @relation("MemoryRelationSource")
  targetRelations MemoryRelation[] @relation("MemoryRelationTarget")

  @@index([scope, path, createdAt(sort: Desc)])
  @@index([embeddingStatus])
  @@index([supersededById])
}

model MemoryRelation {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId  String             @db.Uuid
  targetId  String             @db.Uuid
  type      MemoryRelationType
  createdAt DateTime           @default(now())

  source MemoryBlock @relation("MemoryRelationSource", fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  target MemoryBlock @relation("MemoryRelationTarget", fields: [targetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

// ---------------------------------------------------------------------------
// Phase 4: work documents
// ---------------------------------------------------------------------------
// Documented choices:
// - Documented content is versioned: every create/update/rollback writes an
//   immutable WorkDocVersion snapshot and an audit WorkDocRevision inside one
//   transaction. History is never rewritten or deleted.
// - `WorkDoc.version` is the optimistic-concurrency (CAS) counter updated with
//   a row lock (`FOR UPDATE` in the adapter) so concurrent updates of the same
//   document produce exactly one success and typed conflicts for stale calls.
// - Links are idempotent per (documentId, targetType, targetId) tuple.

enum WorkDocType {
  report
  plan
  analysis
}

enum WorkDocStatus {
  draft
  active
  archived
}

enum WorkDocRevisionSource {
  agent
  user
}

enum WorkDocLinkTargetType {
  memory_block
  chat
  delegation
}

model WorkDoc {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope     String
  chatId    String
  type      WorkDocType
  title     String
  content   String
  status    WorkDocStatus  @default(draft)
  version   Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now())
  // Pre-Phase 6 ownership: NULLABLE BY DESIGN. Legacy rows created before the
  // per-user model have no owner and become inaccessible through user-scoped
  // queries; nothing back-fills or auto-assigns ownership (no leaks).
  ownerId   String?
  owner     User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  versions  WorkDocVersion[]
  revisions WorkDocRevision[]
  links     WorkDocLink[]

  @@index([ownerId])
  @@index([scope, chatId, updatedAt(sort: Desc)])
  @@index([type])
  @@index([status])
}

model WorkDocVersion {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String        @db.Uuid
  version    Int
  title      String
  content    String
  status     WorkDocStatus
  createdAt  DateTime      @default(now())

  document WorkDoc @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([documentId, version])
}

model WorkDocRevision {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String               @db.Uuid
  source      WorkDocRevisionSource
  actorId     String?
  fromVersion Int?
  toVersion   Int
  summary     String
  createdAt   DateTime             @default(now())

  document WorkDoc @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([documentId, toVersion])
}

model WorkDocLink {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String               @db.Uuid
  targetType WorkDocLinkTargetType
  targetId   String
  label      String?
  createdAt  DateTime             @default(now())

  document WorkDoc @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([documentId, targetType, targetId])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Phase 4: delegations (record of parent->child task hand-offs)
// ---------------------------------------------------------------------------
// Documented choices:
// - `childChatId` is globally unique: one child chat belongs to exactly one
//   delegation record, so re-delegating creates a fresh child chat.
// - `depth` is the CHILD agent's composition depth (1..2 per the agent
//   hierarchy: parent depth 0 -> child depth 1, parent depth 1 -> child 2).
// - Status transitions are enforced in the domain layer (see
//   packages/core/src/delegation); the DB stays neutral (no enum-of-next
//   states) so at-least-once queue semantics keep working.

enum DelegationTargetAgent {
  analyst
  researcher
}

enum DelegationMode {
  sync
  async
}

enum DelegationStatus {
  pending
  running
  completed
  failed
  timeout
}

model Delegation {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope           String
  parentChatId    String
  childChatId     String               @unique
  parentMessageId String
  targetAgent     DelegationTargetAgent
  mode            DelegationMode
  status          DelegationStatus     @default(pending)
  task            String
  result          String?
  error           String?
  depth           Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now())
  completedAt     DateTime?
  // Pre-Phase 6 ownership: nullable by design (see WorkDoc comment);
  // deleting the owning user sets owner NULL instead of cascading.
  ownerId         String?
  owner           User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([ownerId])
  @@index([parentChatId, createdAt(sort: Desc)])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 5: agent task scheduler (scheduled agent tasks + executions)
// ---------------------------------------------------------------------------
// Documented choices:
// - Everything is UTC: `timezone` is fixed to the literal "UTC" (SQL CHECK),
//   and next-run computation happens in UTC in the domain (croner with
//   timezone UTC). Recurrence is DST-free by construction.
// - `recurrenceConfig`/`skipDates`/`tokenUsage` are JSONB. The domain schema
//   (packages/core/src/scheduler/schemas.ts) pins the exact per-recurrence
//   shapes; the DB only checks the container (object/array) — SQL-only checks
//   in the migration.
// - A (taskId, scheduledFor) tuple holds at most ONE SCHEDULED execution:
//   enforced ONLY in SQL (partial unique index WHERE trigger='scheduled') so
//   MANUAL and RETRY rows keep unlimited rows per instant. Prisma cannot
//   express partial indexes.
// - `chatId` is globally unique and equals the execution id: one execution ->
//   one isolated chat.
// - `queueJobId`/`repeatJobKey` are nullable UNIQUE (BullMQ identities).
// - Status transitions (the RUNNING->RETRYING/... CAS chain and terminal
//   immutability) are enforced in the domain layer; `attempt` (bounded by
//   `maxAttempts`) and `maxAttempts` (fixed 3) are checked in SQL.
// - `retryOfExecutionId` self-FK ON DELETE SET NULL: deleting a source
//   execution never cascades into retry chains.

enum AgentTaskRecurrenceType {
  once
  daily
  weekly
  monthly
  custom_cron
}

enum AgentTaskAgentSlug {
  general
  orchestrator
  analyst
  researcher
}

enum AgentTaskMode {
  plan
  action
}

enum AgentTaskTrigger {
  scheduled
  manual
  retry
}

enum AgentTaskExecutionStatus {
  pending
  running
  retrying
  completed
  failed
  dead_letter
  skipped
}

model AgentTask {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  agentSlug        AgentTaskAgentSlug
  mode             AgentTaskMode
  prompt           String
  scope            String                  @default("default")
  recurrenceType   AgentTaskRecurrenceType
  recurrenceConfig Json                    @default("{}")
  skipDates        Json                    @default("[]")
  isActive         Boolean                 @default(true)
  timezone         String                  @default("UTC")
  nextRunAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now())
  // Pre-Phase 6 ownership: nullable by design (see WorkDoc comment);
  // deleting the owning user sets owner NULL instead of cascading.
  ownerId          String?
  owner            User?                   @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  executions AgentTaskExecution[]

  @@index([ownerId])
  @@index([isActive, nextRunAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([agentSlug])
}

model AgentTaskExecution {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId             String                   @db.Uuid
  retryOfExecutionId String?                  @db.Uuid
  scheduledFor       DateTime
  trigger            AgentTaskTrigger
  status             AgentTaskExecutionStatus @default(pending)
  attempt            Int                      @default(0)
  maxAttempts        Int                      @default(3)
  durationMs         Int?
  tokenUsage         Json?
  error              String?
  chatId             String                   @unique
  queueJobId         String?                  @unique
  repeatJobKey       String?                  @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now())
  finishedAt         DateTime?
  // Pre-Phase 6 ownership: nullable by design (see WorkDoc comment);
  // deleting the owning user sets owner NULL instead of cascading.
  ownerId            String?
  owner              User?                    @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  task    AgentTask            @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Self-FK: a RETRY execution points at the DEAD_LETTER execution it retries.
  retryOf AgentTaskExecution?  @relation("AgentTaskExecutionRetryOf", fields: [retryOfExecutionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  retries AgentTaskExecution[] @relation("AgentTaskExecutionRetryOf")

  @@index([ownerId])
  @@index([taskId, scheduledFor])
  @@index([status])
  @@index([scheduledFor])
}

// ---------------------------------------------------------------------------
// Pre-Phase 6: Better Auth (Google + GitHub OAuth) + per-user private data
// ---------------------------------------------------------------------------
// Documented choices:
// - User/Session/Account/Verification follow the official Better Auth 1.7
//   Prisma schema generation (`npx auth@<version> generate --adapter prisma
//   --dialect postgresql`): ids are plain TEXT (`String @id`, NO @db.Uuid)
//   minted by Better Auth itself, and relations are declared so the Prisma
//   adapter can use joins. The CLI-generated lowercase `@@map` renames are
//   omitted ON PURPOSE — this repo binds to Prisma-default quoted PascalCase
//   identifiers (see the header note and prisma/README.md); the adapter binds
//   by model name, so the mapped SQL name is irrelevant to it.
// - Sessions persist in the Session table (no secondary storage configured)
//   and are only handed to clients as an httpOnly cookie token.
// - Only the Google and GitHub social providers are wired by the API auth
//   factory; email/password enrollment stays disabled at the factory level,
//   so the schema stays provider-neutral (email + emailVerified exist).
// - UserSettings is the explicit per-user personal-memory opt-in store:
//   `personalMemoryEnabled` defaults to FALSE and is only ever enabled by the
//   user. `userId` is unique (one settings row per user, TEXT like User.id)
//   and cascades on user deletion (private data dies with the owner).
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  // Per-user private data (repo-owned models).
  settings             UserSettings?
  workDocs             WorkDoc[]
  delegations          Delegation[]
  agentTasks           AgentTask[]
  agentTaskExecutions  AgentTaskExecution[]

  @@unique([email])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserSettings {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique
  // Explicit opt-in: the default is opt-OUT (no personal memory until the
  // user turns this on themselves).
  personalMemoryEnabled Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
